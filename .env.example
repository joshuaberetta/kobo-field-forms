# Copy to .env (gitignored) for local runs: `set -a; source .env; set +a`.
# Never commit real tokens.

# Your KoboToolbox API token: {server}/token/ while signed in.
KOBO_TOKEN=
# `global` (kf.kobotoolbox.org), `eu` (eu.kobotoolbox.org), or a server URL.
KOBO_BASE_URL=global
# A plain-http server (e.g. kobo-in-a-box at http://kf.kobo.local) is refused unless this
# is true: the token is then sent unencrypted, so only use it on a closed network.
# KOBO_ALLOW_HTTP=false

# Where forms, layouts, sheets and scans are kept (SQLite + files). Default: ./data
# KFF_HOME=data

# Request timeout in seconds.
# KOBO_TIMEOUT=30
