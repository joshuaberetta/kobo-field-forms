   "label": [
    "East",
    "الشرق"
   ]
  },
  {
   "list_name": "district",
   "name": "d4",
   "label": [
    "West",
    "الغرب"
   ]
  },
  {
   "list_name": "district",
   "name": "d5",
   "label": [
    "Central",
    "الوسط"
   ]
  },
  {
   "list_name": "district",
   "name": "other",
   "label": [
    "Other",
    "أخرى"
   ]
  },
  {
   "list_name": "assets",
   "name": "phone",
   "label": [
    "Mobile phone",
    "هاتف محمول"
   ]
  },
  {
   "list_name": "assets",
   "name": "radio",
   "label": [
    "Radio",
    "راديو"
   ]
  },
  {
   "list_name": "assets",
   "name": "tv",
   "label": [
    "Television",
    "تلفاز"
   ]
  },
  {
   "list_name": "assets",
   "name": "bicycle",
   "label": [
    "Bicycle",
    "دراجة"
   ]
  },
  {
   "list_name": "assets",
   "name": "motorbike",
   "label": [
    "Motorbike",
    "دراجة نارية"
   ]
  },
  {
   "list_name": "assets",
   "name": "fridge",
   "label": [
    "Refrigerator",
    "ثلاجة"
   ]
  },
  {
   "list_name": "sex",
   "name": "female",
   "label": [
    "Female",
    "أنثى"
   ]
  },
  {
   "list_name": "sex",
   "name": "male",
   "label": [
    "Male",
    "ذكر"
   ]
  }
 ],
 "settings": {
  "default_language": "English (en)"
 },
 "translated": [
